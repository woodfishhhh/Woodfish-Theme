{
  "name": "@woodfish/adapter-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "Woodfish adapter for the DeepSeek Harness (dsh) Web UI: selectors, CSS builders and the in-page overlay delivered as a user script.",
  "license": "MIT",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "source": "./src/index.ts",
      "default": "./out/index.js"
    },
    "./renderer": {
      "types": "./out/renderer/index.d.ts",
      "source": "./src/renderer/index.ts",
      "default": "./out/renderer/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "out",
    "src",
    "!**/__tests__"
  ],
  "sideEffects": false,
  "dependencies": {
    "@woodfish/renderer-runtime": "workspace:*",
    "@woodfish/theme-core": "workspace:*"
  },
  "scripts": {
    "compile": "tsc -b && tsc -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "pnpm compile && pnpm format:check && pnpm lint && pnpm test"
  }
}
