{
  "name": "@woodfish/theme-core",
  "version": "0.1.0",
  "private": true,
  "description": "Host-agnostic Woodfish color math, gradient derivation, palettes and effect parameters.",
  "license": "MIT",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "source": "./src/index.ts",
      "default": "./out/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "out",
    "src",
    "!**/__tests__"
  ],
  "sideEffects": false,
  "scripts": {
    "compile": "tsc -b && tsc -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "pnpm compile && pnpm format:check && pnpm lint && pnpm test"
  }
}
