{
  "name": "woodfish-theme",
  "displayName": "Woodfish Theme",
  "description": "为 VS Code、Cursor、Kiro、Windsurf、Trae 等编辑器的任意颜色主题叠加 OKLCH 渐变、发光、彩色光标与毛玻璃；内置 Woodfish Dark / Dracula / Black / Neon / Light 五套主题",
  "version": "7.0.0",
  "publisher": "zhongjun",
  "author": {
    "name": "Woodfish"
  },
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "theme",
    "woodfish",
    "dark",
    "light",
    "black",
    "rainbow",
    "gradient",
    "glow",
    "cursor",
    "frosted glass",
    "acrylic",
    "vibrancy",
    "neon",
    "cyberpunk",
    "dracula",
    "kiro",
    "windsurf",
    "trae",
    "vscodium",
    "open vsx"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "受限模式下仍可使用任意颜色主题与安全的叠层设置，但工作区提供的自定义 CSS 与光标渐变配置不会参与 workbench 注入。",
      "restrictedConfigurations": [
        "woodfishTheme.syntaxGradient.customRules",
        "woodfishTheme.glow.customRules",
        "woodfishTheme.cursor.gradientStops",
        "woodfishTheme.cursor.customRules"
      ]
    }
  },
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Woodfish Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/bearded/Woodfish Dark.json"
      },
      {
        "label": "Woodfish Dracula",
        "uiTheme": "vs-dark",
        "path": "./themes/dracula/Woodfish Dracula.json"
      },
      {
        "label": "Woodfish Black",
        "uiTheme": "vs-dark",
        "path": "./themes/black/Woodfish Black.json"
      },
      {
        "label": "Woodfish Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/neon/Woodfish Neon.json"
      },
      {
        "label": "Woodfish Light",
        "uiTheme": "vs",
        "path": "./themes/light/Woodfish Light.json"
      }
    ],
    "commands": [
      {
        "command": "woodfish-theme.enable",
        "title": "开启 Woodfish 通用叠层",
        "category": "Woodfish Theme",
        "icon": "$(layers-active)"
      },
      {
        "command": "woodfish-theme.disable",
        "title": "关闭 Woodfish 通用叠层",
        "category": "Woodfish Theme",
        "icon": "$(circle-slash)"
      },
      {
        "command": "woodfish-theme.toggleSyntaxGradient",
        "title": "开启/关闭 Woodfish 彩色字体",
        "category": "Woodfish Theme",
        "icon": "$(symbol-color)"
      },
      {
        "command": "woodfish-theme.toggleGlow",
        "title": "开启/关闭 Woodfish 发光字体",
        "category": "Woodfish Theme",
        "icon": "$(sparkle)"
      },
      {
        "command": "woodfish-theme.autoConfigureRainbowCursor",
        "title": "开启 Woodfish 彩色光标",
        "category": "Woodfish Theme",
        "icon": "$(paintcan)"
      },
      {
        "command": "woodfish-theme.toggleRainbowCursor",
        "title": "开启/关闭彩色光标",
        "category": "Woodfish Theme",
        "icon": "$(wand)"
      },
      {
        "command": "woodfish-theme.pickCursorPalette",
        "title": "选择彩色光标配色",
        "category": "Woodfish Theme",
        "icon": "$(symbol-color)"
      },
      {
        "command": "woodfish-theme.toggleGlass",
        "title": "开启/关闭 Woodfish 毛玻璃",
        "category": "Woodfish Theme",
        "icon": "$(window)"
      },
      {
        "command": "woodfish-theme.toggleNativeWindow",
        "title": "开启/关闭系统级透明窗口（实验）",
        "category": "Woodfish Theme",
        "icon": "$(beaker)"
      },
      {
        "command": "woodfish-theme.applyPreset",
        "title": "选择效果预设",
        "category": "Woodfish Theme",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "woodfish-theme.savePreset",
        "title": "将当前效果保存为预设",
        "category": "Woodfish Theme",
        "icon": "$(save)"
      },
      {
        "command": "woodfish-theme.showFeatureMenu",
        "title": "打开 Woodfish 功能菜单",
        "category": "Woodfish Theme",
        "icon": "$(menu)"
      },
      {
        "command": "woodfish-theme.openSettings",
        "title": "打开 Woodfish 设置",
        "category": "Woodfish Theme",
        "icon": "$(settings-gear)"
      },
      {
        "command": "woodfish-theme.repairWorkbench",
        "title": "修复 Woodfish 注入",
        "category": "Woodfish Theme",
        "icon": "$(tools)"
      },
      {
        "command": "woodfish-theme.showDiagnostics",
        "title": "生成 Woodfish 诊断信息",
        "category": "Woodfish Theme",
        "icon": "$(bug)"
      },
      {
        "command": "woodfish-theme.completeUninstall",
        "title": "彻底停用 Woodfish 叠层",
        "category": "Woodfish Theme",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "Woodfish Theme",
      "properties": {
        "woodfishTheme.overlay.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "控制 Woodfish 通用叠层是否安装到当前 VS Code。默认开启，切换到任意颜色主题后仍会继续工作；关闭后会移除整个运行时叠层，但保留各子效果的设置值。",
          "scope": "application",
          "order": 0
        },
        "woodfishTheme.overlay.hueShift": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "maximum": 180,
          "markdownDescription": "控制代码原色在渐变两端的 OKLCH 色相偏移。单位为度，默认 `24` 表示左端 `-24°`、右端 `+24°`；`0` 只保留明暗变化。",
          "scope": "application",
          "order": 1
        },
        "woodfishTheme.overlay.lightnessDelta": {
          "type": "number",
          "default": 0.06,
          "minimum": 0,
          "maximum": 0.5,
          "markdownDescription": "控制代码原色在渐变两端的 OKLCH 明度变化。默认 `0.06`，左端增加、右端减少；算法会自动压回可显示的 sRGB 色域。",
          "scope": "application",
          "order": 2
        },
        "woodfishTheme.overlay.neutralChroma": {
          "type": "number",
          "default": 0.06,
          "minimum": 0,
          "maximum": 0.4,
          "markdownDescription": "为纯白、灰色等低色度文字补充的最小 OKLCH 色度。默认 `0.06`，色相会自动取自当前主题的主要强调色，因此默认前景文字也能获得可见渐变。",
          "scope": "application",
          "order": 3
        },
        "woodfishTheme.overlay.angle": {
          "type": "number",
          "default": 90,
          "minimum": 0,
          "maximum": 360,
          "markdownDescription": "代码渐变方向，单位为度。默认 `90` 为从左到右。",
          "scope": "application",
          "order": 4
        },
        "woodfishTheme.syntaxGradient.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "控制通用叠层是否为 Monaco 代码文字生成渐变。关闭后仍可单独保留文字发光、彩色光标和当前颜色主题。",
          "scope": "application",
          "order": 5
        },
        "woodfishTheme.syntaxGradient.customRules": {
          "type": "array",
          "default": [],
          "maxItems": 32,
          "markdownDescription": "效果：在默认彩色字体层之后追加你自己的 CSS 覆盖。单位：数组，每一项都是一段 CSS 字符串。原理：这些规则会拼接到 syntax gradient 层的最后，因此可以覆盖默认 token 配色。例子：`[\":not(.cursor)[class*='mtk'] { font-weight: 500 !important; }\"]`。为什么要有这个项：给高级用户留一个精细调色出口，而不是继续往设置面板塞更多离散开关。",
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^(?![\\s\\S]*(?:<\\/[sS][tT][yY][lL][eE]\\b|<\\/?[sS][cC][rR][iI][pP][tT]\\b|@[iI][mM][pP][oO][rR][tT]\\b|[uU][rR][lL]\\s*\\())[\\s\\S]*$"
          },
          "scope": "application",
          "order": 6
        },
        "woodfishTheme.glow.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "效果：控制文字发光层是否参与最终注入。单位：布尔开关。原理：关闭后会跳过 glow 的 `text-shadow` 样式。例子：设为 `false` 时可保留彩色字体但去掉霓虹糊边。为什么要有这个项：有人喜欢颜色层次，但不喜欢发光带来的眩光和模糊感。",
          "scope": "application",
          "order": 7
        },
        "woodfishTheme.glow.intensity": {
          "type": "number",
          "default": 1,
          "minimum": 0.1,
          "maximum": 3,
          "markdownDescription": "效果：调节发光的整体强弱。单位：倍率，范围 `0.1 - 3`，`1` 为默认。原理：运行时会按这个倍率缩放默认 `text-shadow` 的模糊半径。例子：`0.6` 更克制，`1.5` 更亮，`2` 以上会明显更霓虹。为什么要有这个项：不同显示器、缩放比例和字体粗细下，固定强度并不总是合适。",
          "scope": "application",
          "order": 8
        },
        "woodfishTheme.glow.customRules": {
          "type": "array",
          "default": [],
          "maxItems": 32,
          "markdownDescription": "效果：在默认发光层后面追加自定义 CSS。单位：数组，每一项是一段 CSS。原理：这些规则会在 glow 层最后拼接，可精确覆盖某些 token 或元素的发光策略。例子：`[\".monaco-editor .view-lines span[class*='mtk'] { text-shadow: none !important; }\"]`。为什么要有这个项：可以只关掉局部发光，或者给个别语法元素单独加重，而不必改扩展源码。",
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^(?![\\s\\S]*(?:<\\/[sS][tT][yY][lL][eE]\\b|<\\/?[sS][cC][rR][iI][pP][tT]\\b|@[iI][mM][pP][oO][rR][tT]\\b|[uU][rR][lL]\\s*\\())[\\s\\S]*$"
          },
          "scope": "application",
          "order": 9
        },
        "woodfishTheme.cursor.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "效果：控制彩色光标主体和尾迹是否一起参与注入。单位：布尔开关。原理：关闭后会跳过 cursor core 和 trail 两层 CSS。例子：设为 `false` 时可保留彩色字体与发光字体，但恢复普通光标。为什么要有这个项：不是所有人都希望光标成为视觉焦点。",
          "scope": "application",
          "order": 10
        },
        "woodfishTheme.cursor.animationDuration": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 60,
          "markdownDescription": "效果：调节彩色光标颜色循环的速度。单位：秒，范围 `1 - 60`。原理：运行时会替换光标动画的持续时间，值越小切换越快。例子：`4` 比较活跃，`8` 是默认，`12` 更平缓。为什么要有这个项：有人喜欢更强的呼吸感，也有人更在意专注度。",
          "scope": "application",
          "order": 11
        },
        "woodfishTheme.cursor.gradientStops": {
          "type": "array",
          "default": [
            "#ff2d95",
            "#ff4500",
            "#ffd700",
            "#7cfc00",
            "#00ffff",
            "#1e90ff",
            "#9370db",
            "#ff00ff",
            "#ff1493"
          ],
          "minItems": 2,
          "maxItems": 16,
          "markdownDescription": "效果：定义彩色光标从上到下的渐变色带。单位：数组，每一项都是 CSS 颜色值。原理：运行时会把这些颜色拼成 `linear-gradient(180deg, ...)`，同时用于主体和尾迹。例子：`[\"#ff2d95\", \"#ffd700\", \"#00ffff\"]`。为什么要有这个项：这是决定彩色光标个性的核心参数，值得开放给用户。",
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\([^()]{1,50}\\)|[a-zA-Z]+)$"
          },
          "scope": "application",
          "order": 12
        },
        "woodfishTheme.cursor.borderRadius": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 24,
          "markdownDescription": "效果：调节彩色光标主体和尾迹的圆角。单位：像素 `px`，范围 `0 - 24`。原理：运行时会替换默认光标 CSS 中的 `border-radius`。例子：`0` 更利落，`2` 默认，`8` 更柔和。为什么要有这个项：不同字体粗细和编辑器缩放下，圆角观感差异很明显。",
          "scope": "application",
          "order": 13
        },
        "woodfishTheme.cursor.glow": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "效果：控制彩色光标的尾迹发光是否启用。单位：布尔开关。原理：关闭后只保留彩色光标主体，不再注入尾迹 pseudo-element。例子：设为 `false` 可保留彩色光标，但去掉拖尾。为什么要有这个项：有人想保留色彩辨识度，但不希望尾迹分散注意力。",
          "scope": "application",
          "order": 14
        },
        "woodfishTheme.cursor.glowBlur": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 24,
          "markdownDescription": "效果：按需开启光标尾迹模糊。单位：像素 `px`，范围 `0 - 24`，默认 `0` 表示不启用 GPU blur。原理：只有值大于 `0` 时，运行时才会添加 `blur(...)`。例子：保持 `0` 获得更低的 GPU 开销，设为 `4` 可恢复柔和光晕。为什么要有这个项：默认优先性能，同时保留用户主动选择模糊效果的能力。",
          "scope": "application",
          "order": 15
        },
        "woodfishTheme.cursor.glowOpacity": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "效果：调节光标尾迹发光的存在感。单位：透明度，范围 `0 - 1`。原理：运行时会替换尾迹层的 `opacity`。例子：`0.35` 更克制，`0.7` 默认，`1` 最亮。为什么要有这个项：这样用户可以控制“看得见多少”，而不是只能全开或全关。",
          "scope": "application",
          "order": 16
        },
        "woodfishTheme.cursor.customRules": {
          "type": "array",
          "default": [],
          "maxItems": 32,
          "markdownDescription": "效果：在默认彩色光标层后追加自定义 CSS。单位：数组，每一项是一段 CSS。原理：这些规则会拼在 cursor 样式最后，可直接覆盖主体或尾迹细节。例子：`[\"div.cursor { width: 3px !important; }\"]`。为什么要有这个项：给高级用户留一个最终覆盖出口，避免为了少量个性化需求继续扩展设置项。",
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^(?![\\s\\S]*(?:<\\/[sS][tT][yY][lL][eE]\\b|<\\/?[sS][cC][rR][iI][pP][tT]\\b|@[iI][mM][pP][oO][rR][tT]\\b|[uU][rR][lL]\\s*\\())[\\s\\S]*$"
          },
          "scope": "application",
          "order": 17
        },
        "woodfishTheme.glass.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "为菜单、悬浮提示、补全列表、命令面板、通知、查找框等浮层开启毛玻璃。底色取自当前颜色主题，无需修改 `workbench.colorCustomizations`。",
          "scope": "application",
          "order": 18
        },
        "woodfishTheme.glass.mode": {
          "type": "string",
          "enum": [
            "blur",
            "acrylic"
          ],
          "enumDescriptions": [
            "CSS 背景模糊 + 噪点颗粒，开销最低、兼容性最好",
            "SVG 亚克力滤镜（模糊 + 颗粒在滤镜内合成），质感更好、开销更高"
          ],
          "default": "blur",
          "markdownDescription": "毛玻璃的渲染方式。",
          "scope": "application",
          "order": 19
        },
        "woodfishTheme.glass.blur": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 60,
          "markdownDescription": "背景模糊半径，单位 `px`。默认 `30`（Fluent Acrylic 推荐值）；`0` 只保留半透明底色。",
          "scope": "application",
          "order": 20
        },
        "woodfishTheme.glass.saturate": {
          "type": "number",
          "default": 125,
          "minimum": 100,
          "maximum": 250,
          "markdownDescription": "背景饱和度，单位 `%`。默认 `125`，让透出的颜色不发灰。",
          "scope": "application",
          "order": 21
        },
        "woodfishTheme.glass.opacity": {
          "type": "number",
          "default": 0.7,
          "minimum": 0.15,
          "maximum": 1,
          "markdownDescription": "浮层底色的不透明度。默认 `0.7` 兼顾通透与文字可读性；在浅色或花哨的背景上建议调高。",
          "scope": "application",
          "order": 22
        },
        "woodfishTheme.glass.noise": {
          "type": "number",
          "default": 0.02,
          "minimum": 0,
          "maximum": 0.2,
          "markdownDescription": "磨砂颗粒强度。默认 `0.02`；`0` 关闭颗粒。",
          "scope": "application",
          "order": 23
        },
        "woodfishTheme.glass.borderRadius": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 16,
          "markdownDescription": "浮层圆角，单位 `px`。默认 `0` 表示跟随 VS Code 自带的圆角设计。",
          "scope": "application",
          "order": 24
        },
        "woodfishTheme.glass.targets": {
          "type": "array",
          "uniqueItems": true,
          "default": [
            "menu",
            "hover",
            "suggest",
            "quickInput",
            "notifications",
            "editorWidget",
            "dropdown",
            "breadcrumbPicker",
            "debugToolbar",
            "stickyScroll",
            "paneHeader",
            "dialog"
          ],
          "items": {
            "type": "string",
            "enum": [
              "menu",
              "hover",
              "suggest",
              "quickInput",
              "notifications",
              "editorWidget",
              "dropdown",
              "breadcrumbPicker",
              "debugToolbar",
              "stickyScroll",
              "paneHeader",
              "dialog"
            ],
            "enumDescriptions": [
              "右键菜单、菜单栏与下拉菜单",
              "悬浮提示（含调试悬浮）",
              "代码补全列表与详情",
              "命令面板 / 快速打开",
              "通知与通知中心",
              "查找、重命名、Code Action 等编辑器小部件",
              "设置页等处的下拉选择框",
              "面包屑选择器",
              "调试工具栏",
              "编辑器与资源管理器的粘性滚动",
              "侧边栏分区标题",
              "模态对话框"
            ]
          },
          "markdownDescription": "哪些浮层使用毛玻璃。",
          "scope": "application",
          "order": 25
        },
        "woodfishTheme.glass.animations": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "菜单、悬浮提示、命令面板等弹出时的入场动画。遵循系统“减少动态效果”与 `workbench.reduceMotion`。",
          "scope": "application",
          "order": 26
        },
        "woodfishTheme.glass.reveal": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Reveal 光效：鼠标划过列表、按钮、标签页时跟随指针的柔光。",
          "scope": "application",
          "order": 27
        },
        "woodfishTheme.glass.nativeWindow.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**实验功能**：让整个 VS Code 窗口透出桌面（macOS vibrancy / Windows 11 亚克力或云母）。需要在 `out/main.js` 开头加入一行受保护的加载语句，生效需完全退出 VS Code；VS Code 更新后需重新开启。关闭、彻底停用或卸载 Woodfish 时自动还原。Linux 不支持。",
          "scope": "application",
          "order": 28
        },
        "woodfishTheme.glass.nativeWindow.windowsMaterial": {
          "type": "string",
          "enum": [
            "acrylic",
            "mica",
            "tabbed"
          ],
          "enumDescriptions": [
            "亚克力：透出窗口后面的内容",
            "云母：取桌面壁纸色调，更省电",
            "标签式云母：颜色更深"
          ],
          "default": "acrylic",
          "markdownDescription": "Windows 11 的系统窗口材质。",
          "scope": "application",
          "order": 29
        },
        "woodfishTheme.glass.nativeWindow.macVibrancy": {
          "type": "string",
          "enum": [
            "under-window",
            "sidebar",
            "fullscreen-ui",
            "hud",
            "window",
            "content"
          ],
          "default": "under-window",
          "markdownDescription": "macOS 的 vibrancy 材质。",
          "scope": "application",
          "order": 30
        },
        "woodfishTheme.glass.nativeWindow.opacity": {
          "type": "number",
          "default": 0.78,
          "minimum": 0.3,
          "maximum": 1,
          "markdownDescription": "系统级透明窗口开启时，编辑器、侧边栏等区域底色的不透明度。",
          "scope": "application",
          "order": 31
        },
        "woodfishTheme.runtime.fixChecksums": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "注入后同步更新 `product.json` 中对应文件的校验和，避免 VS Code 提示“安装似乎损坏”。移除注入时会再次同步。",
          "scope": "application",
          "order": 32
        },
        "woodfishTheme.presets.custom": {
          "type": "object",
          "default": {},
          "markdownDescription": "“保存为预设”记录的自定义预设。建议通过命令 `Woodfish Theme: 选择效果预设` 管理。",
          "additionalProperties": {
            "type": "object"
          },
          "scope": "application",
          "order": 33
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "woodfish-theme.toggleNativeWindow",
          "when": "isMac || isWindows"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "woodfish.gettingStarted",
        "title": "开始使用 Woodfish",
        "description": "三步装好渐变、发光、彩色光标与毛玻璃。",
        "steps": [
          {
            "id": "pickTheme",
            "title": "选一个颜色主题",
            "description": "Woodfish 能叠加在任何颜色主题上。也可以试试内置的 Black（纯黑）、Neon（赛博朋克）和 Light（浅色）。\n[选择颜色主题](command:workbench.action.selectTheme)",
            "media": {
              "markdown": "docs/walkthrough/theme.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.selectTheme"
            ]
          },
          {
            "id": "enable",
            "title": "开启通用叠层",
            "description": "写入渐变、发光和彩色光标，完成后按提示重新加载窗口。\n[开启 Woodfish](command:woodfish-theme.enable)",
            "media": {
              "markdown": "docs/walkthrough/enable.md"
            },
            "completionEvents": [
              "onCommand:woodfish-theme.enable"
            ]
          },
          {
            "id": "preset",
            "title": "挑一套效果预设",
            "description": "柔和护眼、霓虹全开、毛玻璃、专注、性能优先，一键切换。\n[选择效果预设](command:woodfish-theme.applyPreset)",
            "media": {
              "markdown": "docs/walkthrough/preset.md"
            },
            "completionEvents": [
              "onCommand:woodfish-theme.applyPreset"
            ]
          },
          {
            "id": "troubleshoot",
            "title": "遇到问题",
            "description": "VS Code 更新后效果消失时运行“修复注入”；提交 issue 前生成诊断信息；卸载扩展会自动还原所有修改。\n[生成诊断信息](command:woodfish-theme.showDiagnostics)",
            "media": {
              "markdown": "docs/walkthrough/troubleshoot.md"
            },
            "completionEvents": [
              "onCommand:woodfish-theme.showDiagnostics"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -b && tsc -p browser/tsconfig.json",
    "build:dev": "npm run compile && npm run runtime:build",
    "watch": "tsc -b -w",
    "vscode:prepublish": "npm run compile && npm run runtime:build && npm run bundle",
    "vscode:uninstall": "node ./out/uninstall.js",
    "format": "prettier --write \"src/**/*.ts\" \"browser/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"browser/**/*.ts\"",
    "lint": "eslint src browser",
    "lint:fix": "eslint src browser --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "npm run build:dev && node out/integration/runTests.js",
    "pre-publish": "node scripts/pre-publish-check.js",
    "verify": "npm run compile && npm run themes:check && npm run runtime:check && npm run format:check && npm run lint && npm test && npm run pre-publish",
    "publish": "node scripts/publish.js",
    "publish:pre-release": "node scripts/publish.js --pre-release",
    "package": "node scripts/package.js",
    "clean": "rimraf *.vsix",
    "themes:generate": "tsc -b ../../packages/theme-core && node scripts/generate-themes.js",
    "themes:check": "tsc -b ../../packages/theme-core && node scripts/generate-themes.js --check",
    "runtime:build": "node scripts/build-browser-runtime.js",
    "runtime:check": "node scripts/build-browser-runtime.js --check",
    "bundle": "node scripts/bundle.js"
  },
  "devDependencies": {
    "@types/vscode": "1.74.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "@woodfish/renderer-runtime": "0.1.0",
    "@woodfish/theme-core": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/woodfishhhh/Woodfish-Theme.git"
  },
  "bugs": {
    "url": "https://github.com/woodfishhhh/Woodfish-Theme/issues"
  },
  "homepage": "https://github.com/woodfishhhh/Woodfish-Theme#readme",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "images/icon.jpg",
  "vsce": {
    "dependencies": false
  }
