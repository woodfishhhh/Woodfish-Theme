  },
  "scripts": {
    "compile": "tsc -b && tsc -p browser/tsconfig.json",
    "build:dev": "npm run compile && npm run runtime:build",
    "watch": "tsc -b -w",
    "vscode:prepublish": "npm run compile && npm run runtime:build && npm run bundle",
    "vscode:uninstall": "node ./out/uninstall.js",
    "format": "prettier --write \"src/**/*.ts\" \"browser/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"browser/**/*.ts\"",
    "lint": "eslint src browser",
    "lint:fix": "eslint src browser --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "npm run build:dev && node out/integration/runTests.js",
    "pre-publish": "node scripts/pre-publish-check.js",
    "verify": "npm run compile && npm run themes:check && npm run runtime:check && npm run format:check && npm run lint && npm test && npm run pre-publish",
    "publish": "node scripts/publish.js",
    "publish:pre-release": "node scripts/publish.js --pre-release",
    "package": "node scripts/package.js",
    "clean": "rimraf *.vsix",
    "themes:generate": "tsc -b ../../packages/theme-core && node scripts/generate-themes.js && node scripts/port-palettes.js",
    "themes:check": "tsc -b ../../packages/theme-core && node scripts/generate-themes.js --check && node scripts/port-palettes.js --check",
    "runtime:build": "node scripts/build-browser-runtime.js",
    "runtime:check": "node scripts/build-browser-runtime.js --check",
    "bundle": "node scripts/bundle.js"
  },
  "devDependencies": {
    "@types/vscode": "1.74.0",
