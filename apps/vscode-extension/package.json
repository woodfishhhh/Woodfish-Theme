{
  "name": "woodfish-theme",
  "displayName": "Woodfish Theme",
  "description": "为 VS Code、Cursor、Kiro、Windsurf、Trae 等编辑器的任意颜色主题叠加 OKLCH 渐变、发光、彩色光标与毛玻璃；内置 Woodfish Dark / Dracula / Black / Neon / Light 五套主题",
  "version": "7.4.0",
  "publisher": "zhongjun",
  "author": {
    "name": "Woodfish"
  },
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "theme",
    "woodfish",
    "dark",
    "light",
    "black",
    "rainbow",
    "gradient",
    "glow",
    "cursor",
    "frosted glass",
    "acrylic",
    "vibrancy",
    "neon",
    "cyberpunk",
    "dracula",
    "kiro",
    "windsurf",
    "trae",
    "vscodium",
    "open vsx"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "受限模式下仍可使用任意颜色主题与安全的叠层设置，但工作区提供的自定义 CSS 与光标渐变配置不会参与 workbench 注入。",
      "restrictedConfigurations": [
        "woodfishTheme.syntaxGradient.customRules",
        "woodfishTheme.glow.customRules",
        "woodfishTheme.cursor.gradientStops",
        "woodfishTheme.cursor.customRules"
      ]
    }
  },
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Woodfish Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/bearded/Woodfish Dark.json"
      },
      {
        "label": "Woodfish Dracula",
        "uiTheme": "vs-dark",
        "path": "./themes/dracula/Woodfish Dracula.json"
      },
      {
        "label": "Woodfish Black",
        "uiTheme": "vs-dark",
        "path": "./themes/black/Woodfish Black.json"
      },
      {
        "label": "Woodfish Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/neon/Woodfish Neon.json"
      },
      {
        "label": "Woodfish Light",
        "uiTheme": "vs",
        "path": "./themes/light/Woodfish Light.json"
      },
      {
        "label": "Woodfish One Dark Pro",
        "uiTheme": "vs-dark",
        "path": "./themes/onedark/Woodfish One Dark Pro.json"
      },
      {
        "label": "Woodfish Tokyo Night",
        "uiTheme": "vs-dark",
        "path": "./themes/tokyonight/Woodfish Tokyo Night.json"
      },
      {
        "label": "Woodfish Catppuccin Mocha",
        "uiTheme": "vs-dark",
        "path": "./themes/catppuccin-mocha/Woodfish Catppuccin Mocha.json"
      },
      {
        "label": "Woodfish Catppuccin Latte",
        "uiTheme": "vs",
        "path": "./themes/catppuccin-latte/Woodfish Catppuccin Latte.json"
      },
      {
        "label": "Woodfish Nord",
        "uiTheme": "vs-dark",
        "path": "./themes/nord/Woodfish Nord.json"
      },
      {
        "label": "Woodfish GitHub Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/github-dark/Woodfish GitHub Dark.json"
      },
      {
        "label": "Woodfish GitHub Light",
        "uiTheme": "vs",
        "path": "./themes/github-light/Woodfish GitHub Light.json"
      },
      {
        "label": "Woodfish Night Owl",
        "uiTheme": "vs-dark",
        "path": "./themes/nightowl/Woodfish Night Owl.json"
      },
      {
        "label": "Woodfish Ayu Mirage",
        "uiTheme": "vs-dark",
        "path": "./themes/ayu-mirage/Woodfish Ayu Mirage.json"
      },
      {
        "label": "Woodfish Gruvbox Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/gruvbox-dark/Woodfish Gruvbox Dark.json"
      }
    ],
    "commands": [
      {
        "command": "woodfish-theme.enable",
        "title": "开启 Woodfish 通用叠层",
        "category": "Woodfish Theme",
        "icon": "$(layers-active)"
      },
      {
        "command": "woodfish-theme.disable",
        "title": "关闭 Woodfish 通用叠层",
        "category": "Woodfish Theme",
        "icon": "$(circle-slash)"
      },
      {
        "command": "woodfish-theme.toggleSyntaxGradient",
        "title": "开启/关闭 Woodfish 彩色字体",
        "category": "Woodfish Theme",
        "icon": "$(symbol-color)"
      },
      {
        "command": "woodfish-theme.toggleGlow",
        "title": "开启/关闭 Woodfish 发光字体",
        "category": "Woodfish Theme",
        "icon": "$(sparkle)"
      },
      {
        "command": "woodfish-theme.autoConfigureRainbowCursor",
        "title": "开启 Woodfish 彩色光标",
        "category": "Woodfish Theme",
        "icon": "$(paintcan)"
      },
      {
        "command": "woodfish-theme.toggleRainbowCursor",
        "title": "开启/关闭彩色光标",
        "category": "Woodfish Theme",
        "icon": "$(wand)"
      },
      {
        "command": "woodfish-theme.pickCursorPalette",
        "title": "选择彩色光标配色",
        "category": "Woodfish Theme",
        "icon": "$(symbol-color)"
      },
      {
        "command": "woodfish-theme.toggleGlass",
        "title": "开启/关闭 Woodfish 毛玻璃",
        "category": "Woodfish Theme",
        "icon": "$(window)"
      },
      {
        "command": "woodfish-theme.toggleNativeWindow",
        "title": "开启/关闭系统级透明窗口（实验）",
        "category": "Woodfish Theme",
        "icon": "$(beaker)"
      },
      {
        "command": "woodfish-theme.setBackgroundImage",
        "title": "设置背景图片",
        "category": "Woodfish Theme",
        "icon": "$(file-media)"
      },
      {
        "command": "woodfish-theme.applyPreset",
        "title": "选择效果预设",
        "category": "Woodfish Theme",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "woodfish-theme.savePreset",
        "title": "将当前效果保存为预设",
        "category": "Woodfish Theme",
        "icon": "$(save)"
      },
      {
        "command": "woodfish-theme.showFeatureMenu",
        "title": "打开 Woodfish 功能菜单",
        "category": "Woodfish Theme",
        "icon": "$(menu)"
      },
      {
        "command": "woodfish-theme.openSettings",
        "title": "打开 Woodfish 设置",
        "category": "Woodfish Theme",
        "icon": "$(settings-gear)"
      },
      {
        "command": "woodfish-theme.repairWorkbench",
        "title": "修复 Woodfish 注入",
        "category": "Woodfish Theme",
        "icon": "$(tools)"
      },
      {
        "command": "woodfish-theme.showDiagnostics",
        "title": "生成 Woodfish 诊断信息",
        "category": "Woodfish Theme",
        "icon": "$(bug)"
      },
      {
        "command": "woodfish-theme.completeUninstall",
        "title": "彻底停用 Woodfish 叠层",
        "category": "Woodfish Theme",
        "icon": "$(trash)"
      },
      {
        "command": "woodfish-theme.reloadEffects",
        "title": "刷新效果",
        "category": "Woodfish Theme",
        "icon": "$(refresh)"
      },
      {
        "command": "woodfish-theme.openEffectsFolder",
        "title": "打开效果文件夹",
        "category": "Woodfish Theme",
        "icon": "$(folder-opened)"
      },
      {
        "command": "woodfish-theme.codexEnable",
        "title": "为 Codex 启用 Woodfish",
        "category": "Woodfish Theme"
      },
      {
        "command": "woodfish-theme.codexDisable",
        "title": "为 Codex 停用 Woodfish",
        "category": "Woodfish Theme"
      },
      {
        "command": "woodfish-theme.codexUninstall",
        "title": "从 Codex 卸载 Woodfish",
        "category": "Woodfish Theme"
      }
    ],
    "configuration": [
      {
        "id": "woodfishTheme",
        "title": "开关",
        "order": 0,
        "properties": {
          "woodfishTheme.overlay.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "markdownDescription": "Woodfish 效果总开关，适用于任意颜色主题。关闭后移除全部效果，下面各项的设置会保留。想一键换风格，可以用 [效果预设](command:woodfish-theme.applyPreset)。",
            "order": 0
          },
          "woodfishTheme.syntaxGradient.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "markdownDescription": "代码文字显示渐变色。",
            "order": 1
          },
          "woodfishTheme.glow.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "markdownDescription": "代码文字带柔和的发光。",
            "order": 2
          },
          "woodfishTheme.cursor.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "markdownDescription": "光标变成循环变色的彩色光标。",
            "order": 3
          },
          "woodfishTheme.glass.enabled": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "markdownDescription": "菜单、悬浮提示、补全列表、命令面板、通知等弹出层使用毛玻璃，底色跟随当前颜色主题。",
            "order": 4
          }
        }
      },
      {
        "id": "woodfishTheme.overlay",
        "title": "彩色字体",
        "order": 1,
        "properties": {
          "woodfishTheme.overlay.hueShift": {
            "type": "number",
            "default": 32,
            "minimum": 0,
            "maximum": 180,
            "scope": "application",
            "markdownDescription": "渐变从文字原色出发，沿色环转多少度到终点，数值越大首尾颜色差别越大。Woodfish 自带的 5 套主题用特调渐变，这一项只影响其他主题和特调表里没有的颜色。默认 `32`，范围 `0`–`180`。",
            "order": 0
          },
          "woodfishTheme.overlay.lightnessDelta": {
            "type": "number",
            "default": 0.12,
            "minimum": 0,
            "maximum": 0.5,
            "scope": "application",
            "markdownDescription": "渐变终点最多变亮或变暗多少。终点会朝它最鲜艳的亮度靠：橙色转向黄色时变亮，青色转向蓝色时变暗。只影响自动计算的渐变。默认 `0.12`，范围 `0`–`0.5`。",
            "order": 1
          },
          "woodfishTheme.overlay.neutralChroma": {
            "type": "number",
            "default": 0.075,
            "minimum": 0,
            "maximum": 0.4,
            "scope": "application",
            "markdownDescription": "普通文字（编辑器前景色）上那条彩虹的浓淡，`0` 保持原色。只影响自动计算的渐变。默认 `0.075`，范围 `0`–`0.4`。",
            "order": 2
          },
          "woodfishTheme.overlay.angle": {
            "type": "number",
            "default": 45,
            "minimum": 0,
            "maximum": 360,
            "scope": "application",
            "markdownDescription": "自动计算的渐变的方向，单位为度。`45` 从左下到右上，`90` 从左到右。特调渐变自带方向。默认 `45`。",
            "order": 3
          }
        }
      },
      {
        "id": "woodfishTheme.glow",
        "title": "发光字体",
        "order": 2,
        "properties": {
          "woodfishTheme.glow.intensity": {
            "type": "number",
            "default": 1,
            "minimum": 0.1,
            "maximum": 3,
            "scope": "application",
            "markdownDescription": "发光强度倍数。`0.6` 更含蓄，`1.5` 更亮，`2` 以上很霓虹。默认 `1`，范围 `0.1`–`3`。",
            "order": 0
          }
        }
      },
      {
        "id": "woodfishTheme.cursor",
        "title": "彩色光标",
        "order": 3,
        "properties": {
          "woodfishTheme.cursor.gradientStops": {
            "type": "array",
            "default": [
              "#ff2d95",
              "#ff4500",
              "#ffd700",
              "#7cfc00",
              "#00ffff",
              "#1e90ff",
              "#9370db",
              "#ff00ff",
              "#ff1493"
            ],
            "minItems": 2,
            "maxItems": 16,
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\([^()]{1,50}\\)|[a-zA-Z]+)$"
            },
            "scope": "application",
            "markdownDescription": "光标从上到下的颜色，2–16 个，支持 `#hex`、`rgb()`、`hsl()` 和颜色名。不改时使用当前 Woodfish 主题自带的配色。也可以用命令 [选择彩色光标配色](command:woodfish-theme.pickCursorPalette) 挑一套。",
            "order": 0
          },
          "woodfishTheme.cursor.animationDuration": {
            "type": "number",
            "default": 8,
            "minimum": 1,
            "maximum": 60,
            "scope": "application",
            "markdownDescription": "颜色循环一圈的秒数，越小变色越快。默认 `8`，范围 `1`–`60`。",
            "order": 1
          },
          "woodfishTheme.cursor.borderRadius": {
            "type": "number",
            "default": 2,
            "minimum": 0,
            "maximum": 24,
            "scope": "application",
            "markdownDescription": "光标圆角，单位 `px`。默认 `2`，范围 `0`–`24`。",
            "order": 2
          },
          "woodfishTheme.cursor.glow": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "markdownDescription": "光标周围的彩色光晕。",
            "order": 3
          },
          "woodfishTheme.cursor.glowOpacity": {
            "type": "number",
            "default": 0.7,
            "minimum": 0,
            "maximum": 1,
            "scope": "application",
            "markdownDescription": "光晕亮度。默认 `0.7`，范围 `0`–`1`。",
            "order": 4
          },
          "woodfishTheme.cursor.glowBlur": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "maximum": 24,
            "scope": "application",
            "markdownDescription": "光晕模糊，单位 `px`。默认 `0` 不模糊、最省性能；`4` 左右更柔和。范围 `0`–`24`。",
            "order": 5
          }
        }
      },
      {
        "id": "woodfishTheme.glass",
        "title": "毛玻璃",
        "order": 4,
        "properties": {
          "woodfishTheme.glass.targets": {
            "type": "array",
            "uniqueItems": true,
            "default": [
              "menu",
              "hover",
              "suggest",
              "quickInput",
              "notifications",
              "editorWidget",
              "dropdown",
              "breadcrumbPicker",
              "debugToolbar",
              "stickyScroll",
              "paneHeader",
              "dialog"
            ],
            "items": {
              "type": "string",
              "enum": [
                "menu",
                "hover",
                "suggest",
                "quickInput",
                "notifications",
                "editorWidget",
                "dropdown",
                "breadcrumbPicker",
                "debugToolbar",
                "stickyScroll",
                "paneHeader",
                "dialog"
              ],
              "enumDescriptions": [
                "右键菜单、菜单栏与下拉菜单",
                "悬浮提示（含调试悬浮）",
                "代码补全列表与详情",
                "命令面板 / 快速打开",
                "通知与通知中心",
                "查找、重命名、Code Action 等编辑器小部件",
                "设置页等处的下拉选择框",
                "面包屑选择器",
                "调试工具栏",
                "编辑器与资源管理器的粘性滚动",
                "侧边栏分区标题",
                "模态对话框"
              ]
            },
            "scope": "application",
            "markdownDescription": "哪些弹出层使用毛玻璃，默认全部。",
            "order": 0
          },
          "woodfishTheme.glass.opacity": {
            "type": "number",
            "default": 0.7,
            "minimum": 0.15,
            "maximum": 1,
            "scope": "application",
            "markdownDescription": "弹出层底色的不透明度，越小越通透。默认 `0.7`；背景花哨或文字看不清时调高。范围 `0.15`–`1`。",
            "order": 1
          },
          "woodfishTheme.glass.blur": {
            "type": "number",
            "default": 30,
            "minimum": 0,
            "maximum": 60,
            "scope": "application",
            "markdownDescription": "背景模糊程度，单位 `px`。默认 `30`；`0` 只保留半透明底色。范围 `0`–`60`。",
            "order": 2
          },
          "woodfishTheme.glass.mode": {
            "type": "string",
            "enum": [
              "blur",
              "acrylic"
            ],
            "enumDescriptions": [
              "普通模糊：开销低、兼容性好",
              "亚克力：质感更好，开销稍高"
            ],
            "default": "blur",
            "scope": "application",
            "markdownDescription": "毛玻璃的画法。",
            "order": 3
          },
          "woodfishTheme.glass.saturate": {
            "type": "number",
            "default": 125,
            "minimum": 100,
            "maximum": 250,
            "scope": "application",
            "markdownDescription": "透出背景的鲜艳程度，单位 `%`。默认 `125`，避免颜色发灰。范围 `100`–`250`。",
            "order": 4
          },
          "woodfishTheme.glass.noise": {
            "type": "number",
            "default": 0.02,
            "minimum": 0,
            "maximum": 0.2,
            "scope": "application",
            "markdownDescription": "磨砂颗粒感。默认 `0.02`；`0` 关闭颗粒。范围 `0`–`0.2`。",
            "order": 5
          },
          "woodfishTheme.glass.borderRadius": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "maximum": 16,
            "scope": "application",
            "markdownDescription": "弹出层圆角，单位 `px`。默认 `0` 表示沿用 VS Code 自带的圆角。范围 `0`–`16`。",
            "order": 6
          },
          "woodfishTheme.glass.animations": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "markdownDescription": "菜单、悬浮提示、命令面板弹出时的淡入动画。系统开启“减少动态效果”或 `workbench.reduceMotion` 时自动关闭。",
            "order": 7
          },
          "woodfishTheme.glass.reveal": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "markdownDescription": "鼠标划过列表、按钮、标签页时，跟随指针的柔光。",
            "order": 8
          }
        }
      },
      {
        "id": "woodfishTheme.glass.nativeWindow",
        "title": "透明窗口（实验）",
        "order": 5,
        "properties": {
          "woodfishTheme.glass.nativeWindow.enabled": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "markdownDescription": "让整个窗口透出桌面（Windows 11 亚克力 / 云母，macOS vibrancy），Linux 不支持。开启后需要**完全退出**编辑器再打开；编辑器更新后要重新开启。关闭或卸载 Woodfish 时自动还原。",
            "order": 0
          },
          "woodfishTheme.glass.nativeWindow.windowsMaterial": {
            "type": "string",
            "enum": [
              "acrylic",
              "mica",
              "tabbed"
            ],
            "enumDescriptions": [
              "亚克力：透出窗口后面的内容",
              "云母：取桌面壁纸色调，更省电",
              "标签式云母：颜色更深"
            ],
            "default": "acrylic",
            "scope": "application",
            "markdownDescription": "Windows 11 上的窗口材质。",
            "order": 1
          },
          "woodfishTheme.glass.nativeWindow.macVibrancy": {
            "type": "string",
            "enum": [
              "under-window",
              "sidebar",
              "fullscreen-ui",
              "hud",
              "window",
              "content"
            ],
            "default": "under-window",
            "scope": "application",
            "markdownDescription": "macOS 上的窗口材质。",
            "order": 2,
            "enumDescriptions": [
              "窗口下方（推荐）",
              "侧边栏",
              "全屏界面",
              "HUD 浮窗，偏深",
              "窗口",
              "内容区"
            ]
          },
          "woodfishTheme.glass.nativeWindow.opacity": {
            "type": "number",
            "default": 0.78,
            "minimum": 0.3,
            "maximum": 1,
            "scope": "application",
            "markdownDescription": "透明窗口下编辑器、侧边栏底色的不透明度，越小越透。默认 `0.78`，范围 `0.3`–`1`。",
            "order": 3
          }
        }
      },
      {
        "id": "woodfishTheme.background",
        "title": "窗口背景",
        "order": 6,
        "properties": {
          "woodfishTheme.background.enabled": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "markdownDescription": "在窗口底下铺一张图片，编辑器透出背景，侧边栏和面板用毛玻璃叠在上面。默认图片是作者 woodfish 制作的《彩云》；用命令 **Woodfish Theme: 设置背景图片** 换成自己的图片。改动后需要重新加载窗口。",
            "order": 0
          },
          "woodfishTheme.background.image": {
            "type": "string",
            "default": "",
            "scope": "application",
            "markdownDescription": "由 **设置背景图片** 命令写入：留空是《彩云》，`gradient` 是彩云渐变，其他值是复制到 Woodfish 存储目录的图片。",
            "order": 1
          },
          "woodfishTheme.background.opacity": {
            "type": "number",
            "default": 0.15,
            "minimum": 0,
            "maximum": 1,
            "scope": "application",
            "markdownDescription": "背景图透出来的程度。默认 `0.15`，范围 `0`–`1`。",
            "order": 2
          },
          "woodfishTheme.background.blur": {
            "type": "number",
            "default": 10,
            "minimum": 0,
            "maximum": 60,
            "scope": "application",
            "markdownDescription": "侧边栏和面板毛玻璃的模糊半径（像素）。默认 `10`，范围 `0`–`60`。",
            "order": 3
          },
          "woodfishTheme.background.mask": {
            "type": "number",
            "default": 0.35,
            "minimum": 0,
            "maximum": 1,
            "scope": "application",
            "markdownDescription": "遮罩：侧边栏和面板盖在背景上的主题色浓度，越大越不透明、文字越清楚。默认 `0.35`，范围 `0`–`1`。",
            "order": 4
          }
        }
      },
      {
        "id": "woodfishTheme.effects",
        "title": "效果插件",
        "order": 7,
        "properties": {
          "woodfishTheme.effects.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "order": 0,
            "markdownDescription": "加载效果插件：下面三个，以及和 Codex 共用的效果文件夹（`%APPDATA%\\Woodfish\\effects`）里的其他效果。改了效果文件会自动刷新，也可运行 **Woodfish Theme: 刷新效果**（`Ctrl+Alt+R`）。改这个总开关要重新加载窗口。"
          },
          "woodfishTheme.mouseTrail.enabled": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "order": 1,
            "markdownDescription": "**鼠标拖尾**：鼠标指针身后拖一条单色带子（照抄 Animations 插件）。在 VS Code 里默认关闭，打开就有。参数和 Codex 的 `mouse-trail` 同名同义。"
          },
          "woodfishTheme.mouseTrail.length": {
            "scope": "application",
            "order": 2,
            "markdownDescription": "鼠标拖尾 · 拖尾长度：带子由多少个点连成，越大拖得越长（Animations 插件的 TrailLength）",
            "type": "number",
            "default": 12,
            "minimum": 2,
            "maximum": 50
          },
          "woodfishTheme.mouseTrail.style": {
            "scope": "application",
            "order": 3,
            "markdownDescription": "鼠标拖尾 · 样式：Animations 插件的 CursorStyle：block 是实心带子，line 是四条细线",
            "type": "string",
            "default": "block",
            "enum": [
              "block",
              "line"
            ],
            "enumDescriptions": [
              "实心带子",
              "四条细线"
            ]
          },
          "woodfishTheme.mouseTrail.width": {
            "scope": "application",
            "order": 4,
            "markdownDescription": "鼠标拖尾 · 宽度：带子的宽度（插件给光标的默认尺寸是 7px）",
            "type": "number",
            "default": 7,
            "minimum": 1,
            "maximum": 24
          },
          "woodfishTheme.mouseTrail.height": {
            "scope": "application",
            "order": 5,
            "markdownDescription": "鼠标拖尾 · 高度：带子的高度，默认是宽度的 2.2 倍，和箭头差不多高",
            "type": "number",
            "default": 15.4,
            "minimum": 1,
            "maximum": 48
          },
          "woodfishTheme.mouseTrail.color": {
            "scope": "application",
            "order": 6,
            "markdownDescription": "鼠标拖尾 · 颜色：单色，Animations 插件默认白色",
            "type": "string",
            "format": "color-hex",
            "default": "#ffffff"
          },
          "woodfishTheme.mouseTrail.followTheme": {
            "scope": "application",
            "order": 7,
            "markdownDescription": "鼠标拖尾 · 颜色跟随主题：打开后用当前主题的强调色，不用上面的颜色",
            "type": "boolean",
            "default": false
          },
          "woodfishTheme.mouseTrail.opacity": {
            "scope": "application",
            "order": 8,
            "markdownDescription": "鼠标拖尾 · 不透明度：1 是插件原样的实心效果，调小更含蓄",
            "type": "number",
            "default": 1,
            "minimum": 0.05,
            "maximum": 1
          },
          "woodfishTheme.caretTrail.enabled": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "order": 9,
            "markdownDescription": "**光标拖尾**：文字光标身后拖一条单色带子（照抄 Animations 插件）。已开着 Animations 插件的光标动画会画两条，默认关闭。参数和 Codex 的 `caret-trail` 同名同义。"
          },
          "woodfishTheme.caretTrail.length": {
            "scope": "application",
            "order": 10,
            "markdownDescription": "光标拖尾 · 拖尾长度：带子由多少个点连成（负责人 VS Code 里 Animations 的 TrailLength 是 12）",
            "type": "number",
            "default": 12,
            "minimum": 2,
            "maximum": 50
          },
          "woodfishTheme.caretTrail.style": {
            "scope": "application",
            "order": 11,
            "markdownDescription": "光标拖尾 · 样式：Animations 插件的 CursorStyle",
            "type": "string",
            "default": "block",
            "enum": [
              "block",
              "line"
            ],
            "enumDescriptions": [
              "实心带子",
              "四条细线"
            ]
          },
          "woodfishTheme.caretTrail.width": {
            "scope": "application",
            "order": 12,
            "markdownDescription": "光标拖尾 · 宽度：光标宽度（负责人 VS Code 的 editor.cursorWidth 是 6）；宿主报告了光标宽度时用宿主的",
            "type": "number",
            "default": 6,
            "minimum": 1,
            "maximum": 24
          },
          "woodfishTheme.caretTrail.color": {
            "scope": "application",
            "order": 13,
            "markdownDescription": "光标拖尾 · 颜色：单色，Animations 插件默认白色",
            "type": "string",
            "format": "color-hex",
            "default": "#ffffff"
          },
          "woodfishTheme.caretTrail.followTheme": {
            "scope": "application",
            "order": 14,
            "markdownDescription": "光标拖尾 · 颜色跟随主题：打开后用当前主题的强调色",
            "type": "boolean",
            "default": false
          },
          "woodfishTheme.caretTrail.opacity": {
            "scope": "application",
            "order": 15,
            "markdownDescription": "光标拖尾 · 不透明度：1 是插件原样",
            "type": "number",
            "default": 1,
            "minimum": 0.05,
            "maximum": 1
          },
          "woodfishTheme.caretTrail.sources": {
            "scope": "application",
            "order": 16,
            "markdownDescription": "光标拖尾 · 跟随谁：Codex 里 AI 流式吐字时，末尾也算一个光标",
            "type": "string",
            "default": "all",
            "enum": [
              "all",
              "user",
              "ai"
            ],
            "enumDescriptions": [
              "你的光标和 AI 吐字",
              "只跟你的光标",
              "只跟 AI 吐字"
            ]
          },
          "woodfishTheme.typingParticles.enabled": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "order": 17,
            "markdownDescription": "**打字粒子**：打字时从光标处迸出主题色光点（像 Power Mode）。在 VS Code 里默认关闭，打开就有。参数和 Codex 的 `typing-particles` 同名同义。"
          },
          "woodfishTheme.typingParticles.count": {
            "scope": "application",
            "order": 18,
            "markdownDescription": "打字粒子 · 每次粒子数：每插入一次文字迸出多少颗",
            "type": "number",
            "default": 8,
            "minimum": 1,
            "maximum": 40
          },
          "woodfishTheme.typingParticles.size": {
            "scope": "application",
            "order": 19,
            "markdownDescription": "打字粒子 · 粒子大小：光点半径",
            "type": "number",
            "default": 2.2,
            "minimum": 0.5,
            "maximum": 8
          },
          "woodfishTheme.typingParticles.speed": {
            "scope": "application",
            "order": 20,
            "markdownDescription": "打字粒子 · 迸出速度：初速度（像素/秒），越大飞得越远",
            "type": "number",
            "default": 170,
            "minimum": 20,
            "maximum": 600
          },
          "woodfishTheme.typingParticles.spread": {
            "scope": "application",
            "order": 21,
            "markdownDescription": "打字粒子 · 散开角度：以正上方为中心的扇形角度，360 是四面八方",
            "type": "number",
            "default": 150,
            "minimum": 10,
            "maximum": 360
          },
          "woodfishTheme.typingParticles.gravity": {
            "scope": "application",
            "order": 22,
            "markdownDescription": "打字粒子 · 重力：向下的加速度（像素/秒²），负数会往上飘",
            "type": "number",
            "default": 450,
            "minimum": -400,
            "maximum": 1500
          },
          "woodfishTheme.typingParticles.life": {
            "scope": "application",
            "order": 23,
            "markdownDescription": "打字粒子 · 存活时间：每颗粒子从出现到消失的时间",
            "type": "number",
            "default": 650,
            "minimum": 100,
            "maximum": 2000
          },
          "woodfishTheme.typingParticles.colors": {
            "scope": "application",
            "order": 24,
            "markdownDescription": "打字粒子 · 颜色：主题渐变色取当前主题的光标色；单色用下面的颜色",
            "type": "string",
            "default": "theme",
            "enum": [
              "theme",
              "rainbow",
              "single"
            ],
            "enumDescriptions": [
              "主题渐变色",
              "Woodfish 彩虹",
              "单色"
            ]
          },
          "woodfishTheme.typingParticles.color": {
            "scope": "application",
            "order": 25,
            "markdownDescription": "打字粒子 · 单色颜色：颜色选“单色”时用",
            "type": "string",
            "format": "color-hex",
            "default": "#ffffff"
          },
          "woodfishTheme.typingParticles.sources": {
            "scope": "application",
            "order": 26,
            "markdownDescription": "打字粒子 · 谁触发：Codex 里 AI 流式输出也算“打字”",
            "type": "string",
            "default": "all",
            "enum": [
              "all",
              "user",
              "ai"
            ],
            "enumDescriptions": [
              "你打字和 AI 吐字",
              "只在你打字时",
              "只在 AI 吐字时"
            ]
          },
          "woodfishTheme.typingParticles.shake": {
            "scope": "application",
            "order": 27,
            "markdownDescription": "打字粒子 · 震动：打字时编辑区轻轻一抖（负责人的 Power Mode 关了震动）",
            "type": "boolean",
            "default": false
          }
        }
      },
      {
        "id": "woodfishTheme.advanced",
        "title": "高级",
        "order": 8,
        "properties": {
          "woodfishTheme.syntaxGradient.customRules": {
            "type": "array",
            "default": [],
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(?![\\s\\S]*(?:<\\/[sS][tT][yY][lL][eE]\\b|<\\/?[sS][cC][rR][iI][pP][tT]\\b|@[iI][mM][pP][oO][rR][tT]\\b|[uU][rR][lL]\\s*\\())[\\s\\S]*$"
            },
            "scope": "application",
            "markdownDescription": "追加在彩色字体之后的自定义 CSS，每项一条规则。例如 `\":not(.cursor)[class*='mtk'] { font-weight: 500 !important; }\"`。",
            "order": 0
          },
          "woodfishTheme.glow.customRules": {
            "type": "array",
            "default": [],
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(?![\\s\\S]*(?:<\\/[sS][tT][yY][lL][eE]\\b|<\\/?[sS][cC][rR][iI][pP][tT]\\b|@[iI][mM][pP][oO][rR][tT]\\b|[uU][rR][lL]\\s*\\())[\\s\\S]*$"
            },
            "scope": "application",
            "markdownDescription": "追加在发光字体之后的自定义 CSS，每项一条规则。例如关掉某类文字的发光：`\".monaco-editor .view-lines span[class*='mtk'] { text-shadow: none !important; }\"`。",
            "order": 1
          },
          "woodfishTheme.cursor.customRules": {
            "type": "array",
            "default": [],
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(?![\\s\\S]*(?:<\\/[sS][tT][yY][lL][eE]\\b|<\\/?[sS][cC][rR][iI][pP][tT]\\b|@[iI][mM][pP][oO][rR][tT]\\b|[uU][rR][lL]\\s*\\())[\\s\\S]*$"
            },
            "scope": "application",
            "markdownDescription": "追加在彩色光标之后的自定义 CSS，每项一条规则。例如 `\"div.cursor { width: 3px !important; }\"`。",
            "order": 2
          },
          "woodfishTheme.runtime.fixChecksums": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "markdownDescription": "写入效果后同步更新编辑器的文件校验和，避免出现“安装似乎损坏”的提示。一般不需要关闭。",
            "order": 3
          },
          "woodfishTheme.presets.custom": {
            "type": "object",
            "default": {},
            "additionalProperties": {
              "type": "object"
            },
            "scope": "application",
            "markdownDescription": "“保存为预设”记下的自定义预设。建议用命令 [选择效果预设](command:woodfish-theme.applyPreset) 管理，不用手动编辑。",
            "order": 4
          }
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "woodfish-theme.toggleNativeWindow",
          "when": "isMac || isWindows"
        },
        {
          "command": "woodfish-theme.codexEnable",
          "when": "isWindows"
        },
        {
          "command": "woodfish-theme.codexDisable",
          "when": "isWindows"
        },
        {
          "command": "woodfish-theme.codexUninstall",
          "when": "isWindows"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "woodfish.gettingStarted",
        "title": "开始使用 Woodfish",
        "description": "三步装好渐变、发光、彩色光标与毛玻璃。",
        "steps": [
          {
            "id": "pickTheme",
            "title": "选一个颜色主题",
            "description": "Woodfish 能叠加在任何颜色主题上。也可以试试内置的 Black（纯黑）、Neon（赛博朋克）和 Light（浅色）。\n[选择颜色主题](command:workbench.action.selectTheme)",
            "media": {
              "markdown": "docs/walkthrough/theme.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.selectTheme"
            ]
          },
          {
            "id": "enable",
            "title": "开启通用叠层",
            "description": "写入渐变、发光和彩色光标，完成后按提示重新加载窗口。\n[开启 Woodfish](command:woodfish-theme.enable)",
            "media": {
              "markdown": "docs/walkthrough/enable.md"
            },
            "completionEvents": [
              "onCommand:woodfish-theme.enable"
            ]
          },
          {
            "id": "preset",
            "title": "挑一套效果预设",
            "description": "柔和护眼、霓虹全开、毛玻璃、专注、性能优先，一键切换。\n[选择效果预设](command:woodfish-theme.applyPreset)",
            "media": {
              "markdown": "docs/walkthrough/preset.md"
            },
            "completionEvents": [
              "onCommand:woodfish-theme.applyPreset"
            ]
          },
          {
            "id": "troubleshoot",
            "title": "遇到问题",
            "description": "VS Code 更新后效果消失时运行“修复注入”；提交 issue 前生成诊断信息；卸载扩展会自动还原所有修改。\n[生成诊断信息](command:woodfish-theme.showDiagnostics)",
            "media": {
              "markdown": "docs/walkthrough/troubleshoot.md"
            },
            "completionEvents": [
              "onCommand:woodfish-theme.showDiagnostics"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "woodfish-theme.reloadEffects",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -b && tsc -p browser/tsconfig.json",
    "build:dev": "pnpm compile && pnpm runtime:build",
    "watch": "tsc -b -w",
    "vscode:prepublish": "pnpm compile && pnpm runtime:build && pnpm bundle",
    "vscode:uninstall": "node ./out/uninstall.js",
    "format": "prettier --write \"src/**/*.ts\" \"browser/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"browser/**/*.ts\"",
    "lint": "eslint src browser",
    "lint:fix": "eslint src browser --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "pnpm build:dev && node out/integration/runTests.js",
    "pre-publish": "node scripts/pre-publish-check.js",
    "verify": "pnpm compile && pnpm themes:check && pnpm runtime:check && pnpm format:check && pnpm lint && pnpm test && pnpm pre-publish",
    "publish": "node scripts/publish.js",
    "publish:pre-release": "node scripts/publish.js --pre-release",
    "package": "node scripts/package.js",
    "clean": "rimraf *.vsix",
    "themes:generate": "tsc -b ../../packages/theme-core && node scripts/generate-themes.js && node scripts/port-palettes.js",
    "themes:check": "tsc -b ../../packages/theme-core && node scripts/generate-themes.js --check && node scripts/port-palettes.js --check",
    "runtime:build": "node scripts/build-browser-runtime.js",
    "runtime:check": "node scripts/build-browser-runtime.js --check",
    "bundle": "node scripts/bundle.js"
  },
  "devDependencies": {
    "@types/vscode": "1.74.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "@woodfish/effects": "workspace:*",
    "@woodfish/renderer-runtime": "workspace:*",
    "@woodfish/theme-core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/woodfishhhh/Woodfish-Theme.git"
  },
  "bugs": {
    "url": "https://github.com/woodfishhhh/Woodfish-Theme/issues"
  },
  "homepage": "https://github.com/woodfishhhh/Woodfish-Theme#readme",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "images/icon.jpg",
  "vsce": {
    "dependencies": false
  }
}
