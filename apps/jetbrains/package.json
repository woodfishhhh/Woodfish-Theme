{
  "name": "@woodfish/jetbrains",
  "private": true,
  "scripts": {
    "jetbrains:generate": "tsc -b ../../packages/theme-core && node scripts/generate.js",
    "jetbrains:check": "tsc -b ../../packages/theme-core && node scripts/generate.js --check",
    "test": "tsc -b ../../packages/theme-core && jest --testEnvironment=node",
    "lint": "eslint --no-ignore --config eslint.config.mjs scripts/*.js",
    "format:check": "prettier --check scripts/*.js eslint.config.mjs"
  },
  "dependencies": {
    "@woodfish/theme-core": "workspace:*"
  },
  "jest": {
    "roots": [
      "<rootDir>/scripts"
    ]
  }
}
