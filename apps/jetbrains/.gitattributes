# 换行统一：源码与脚本用 LF，Windows 批处理用 CRLF
* text=auto

*.java text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.properties text eol=lf
*.txt text eol=lf

# 在 macOS / Linux 上直接 ./gradlew 必须能跑
gradlew text eol=lf
*.bat text eol=crlf

# 二进制
*.jar binary
*.png binary
*.jpg binary
