<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>io.github.woodfishhhh.woodfishtheme</id>
    <name>Woodfish Theme</name>
    <vendor url="https://github.com/woodfishhhh/Woodfish-Theme">Woodfish</vendor>

    <description><![CDATA[
    <p><a href="https://github.com/woodfishhhh/Woodfish-Theme">Woodfish Theme</a> for JetBrains IDEs: 15 color themes
    (UI theme and editor color scheme together) that match the VS Code themes color for color, with shared syntax gradients, glow and editor effects.</p>
    <ul>
      <li><b>15 themes</b>: Woodfish Dark, Dracula, Light, Black, Neon, One Dark Pro, Tokyo Night, Catppuccin Mocha,
      Catppuccin Latte, Nord, GitHub Dark, GitHub Light, Night Owl, Ayu Mirage and Gruvbox Dark. Choose one in
      Settings | Appearance &amp; Behavior | Appearance.</li>
      <li><b>Gradient syntax</b>: the five original themes use their designed stops. Other colors follow the shared OKLCH algorithm.</li>
      <li><b>Glow</b>: adjustable layered glow under the text.</li>
      <li><b>CJK included</b>: Chinese, Japanese and Korean text gets the same treatment without ghosting.</li>
      <li><b>Editor effects</b>: a rainbow caret, caret trails, typing particles and image backgrounds.</li>
      <li><b>Presets</b>: seven built-in looks and your own saved combinations.</li>
    </ul>
    <p>Woodfish Theme 的 JetBrains 版：15 套主题（界面主题加编辑器配色），颜色与 VS Code 版一一对应；
    在“设置 → 工具 → Woodfish Theme”中调整渐变、光晕、彩虹光标、输入动效、背景和圆角。</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 15 color themes: files are generated by `pnpm jetbrains:generate`, `jetbrains:check` verifies this list -->
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.dark" path="/themes/woodfish-dark.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.dracula" path="/themes/woodfish-dracula.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.light" path="/themes/woodfish-light.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.black" path="/themes/woodfish-black.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.neon" path="/themes/woodfish-neon.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.onedark" path="/themes/woodfish-onedark.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.tokyonight" path="/themes/woodfish-tokyonight.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.catppuccin-mocha" path="/themes/woodfish-catppuccin-mocha.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.catppuccin-latte" path="/themes/woodfish-catppuccin-latte.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.nord" path="/themes/woodfish-nord.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.github-dark" path="/themes/woodfish-github-dark.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.github-light" path="/themes/woodfish-github-light.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.nightowl" path="/themes/woodfish-nightowl.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.ayu-mirage" path="/themes/woodfish-ayu-mirage.theme.json"/>
        <themeProvider id="io.github.woodfishhhh.woodfishtheme.gruvbox-dark" path="/themes/woodfish-gruvbox-dark.theme.json"/>

        <!-- 通用叠层主入口：为每个编辑器挂载渐变与发光渲染 -->
        <editorFactoryListener implementation="com.github.yyyyolo7a79.woodfish.editor.WoodfishEditorManager"/>

        <!-- 设置页：Settings | Tools | Woodfish Theme -->
        <applicationConfigurable parentId="tools"
                                 id="com.github.yyyyolo7a79.woodfish.settings"
                                 displayName="Woodfish Theme"
                                 instance="com.github.yyyyolo7a79.woodfish.ui.WoodfishConfigurable"/>

        <!-- 状态栏：显示 on / off 与正在生效的效果层，点击打开功能菜单 -->
        <statusBarWidgetFactory id="com.github.yyyyolo7a79.woodfish.status"
                                implementation="com.github.yyyyolo7a79.woodfish.ui.WoodfishStatusWidgetFactory"
                                order="last"/>

        <notificationGroup id="Woodfish Theme" displayType="BALLOON"/>
    </extensions>

    <resource-bundle>messages.WoodfishBundle</resource-bundle>

    <actions>
        <group id="Woodfish.Menu" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="Woodfish.ToggleOverlay"
                    class="com.github.yyyyolo7a79.woodfish.ui.actions.ToggleOverlayAction"/>
            <action id="Woodfish.ToggleSyntaxGradient"
                    class="com.github.yyyyolo7a79.woodfish.ui.actions.ToggleSyntaxGradientAction"/>
            <action id="Woodfish.ToggleGlow"
                    class="com.github.yyyyolo7a79.woodfish.ui.actions.ToggleGlowAction"/>
            <separator/>
            <action id="Woodfish.ApplyPreset"
                    class="com.github.yyyyolo7a79.woodfish.ui.actions.ApplyPresetAction"/>
            <action id="Woodfish.SavePreset"
                    class="com.github.yyyyolo7a79.woodfish.ui.actions.SavePresetAction"/>
            <separator/>
            <action id="Woodfish.OpenSettings"
                    class="com.github.yyyyolo7a79.woodfish.ui.actions.OpenSettingsAction"/>
            <action id="Woodfish.CopyDiagnostics"
                    class="com.github.yyyyolo7a79.woodfish.ui.actions.CopyDiagnosticsAction"/>
        </group>

        <!-- 不进菜单：状态栏点击时弹出，也可用 Find Action（Ctrl+Shift+A）搜到 -->
        <action id="Woodfish.ShowFeatureMenu"
                class="com.github.yyyyolo7a79.woodfish.ui.actions.ShowFeatureMenuAction"/>
    </actions>
</idea-plugin>
