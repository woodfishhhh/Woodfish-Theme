  "workbench.colorTheme": "Woodfish Dark",
  "terminal.integrated.env.linux": { "EDITOR": "nvim", "LANG": "en_US.UTF-8" },
  "search.exclude": null,
  "build": {
    "matrix": [
      { "os": "ubuntu-latest", "node": 20, "experimental": false },
      { "os": "windows-latest", "node": 22, "experimental": false },
      { "os": "macos-14", "node": 22, "experimental": true }
    ],
    "steps": [
      "checkout",
      "install",
      "lint",
      "test --coverage",
      "package"
    ],
    "timeout": 600,
    "cache": { "key": "pnpm-${{ hashFiles('pnpm-lock.yaml') }}", "paths": ["~/.pnpm-store"] }
  },
