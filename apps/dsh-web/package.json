{
  "name": "@woodfish/dsh-web",
  "version": "1.0.0",
  "private": true,
  "description": "Woodfish native plugin for DeepSeek Harness (dsh web & dsh desktop): Host settings/background service, intrusive CSS & effects takeover, and full-parameter native Settings UI.",
  "license": "MIT",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "source": "./src/index.ts",
      "default": "./out/index.js"
    },
    "./renderer": {
      "types": "./out/renderer/index.d.ts",
      "source": "./src/renderer/index.ts",
      "default": "./out/renderer/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "out",
    "plugin",
    "src",
    "!**/__tests__"
  ],
  "sideEffects": false,
  "dependencies": {
    "@woodfish/renderer-runtime": "workspace:*",
    "@woodfish/theme-core": "workspace:*"
  },
  "scripts": {
    "compile": "tsc -b && tsc -p tsconfig.test.json",
    "dsh:build": "node scripts/build.js",
    "dsh:check": "node scripts/build.js --check",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "pnpm compile && pnpm dsh:check && pnpm format:check && pnpm lint && pnpm test"
  }
}
