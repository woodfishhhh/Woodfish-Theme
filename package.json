{
  "name": "woodfish-workspace",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "description": "Woodfish monorepo: shared theme core plus per-host apps (VS Code extension first).",
  "license": "MIT",
  "scripts": {
    "compile": "pnpm -r --if-present run compile",
    "build:dev": "pnpm --filter ./apps/vscode-extension run build:dev",
    "format": "pnpm -r --if-present run format",
    "format:check": "pnpm -r --if-present run format:check",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "verify": "pnpm -r --if-present run verify",
    "test:integration": "pnpm --filter ./apps/vscode-extension run test:integration",
    "themes:generate": "pnpm --filter ./apps/vscode-extension run themes:generate",
    "themes:check": "pnpm --filter ./apps/vscode-extension run themes:check",
    "runtime:build": "pnpm --filter ./apps/vscode-extension run runtime:build",
    "runtime:check": "pnpm --filter ./apps/vscode-extension run runtime:check",
    "codex:build": "pnpm --filter ./apps/desktop-cli run codex:build",
    "codex:check": "pnpm --filter ./apps/desktop-cli run codex:check",
    "woodfish": "node apps/desktop-cli/out/woodfish.js",
    "package": "pnpm --filter ./apps/vscode-extension run package",
    "pre-publish": "pnpm --filter ./apps/vscode-extension run pre-publish",
    "publish:vscode": "pnpm --filter ./apps/vscode-extension run publish",
    "publish:vscode:pre-release": "pnpm --filter ./apps/vscode-extension run publish:pre-release"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@ljharb/tsconfig": "^0.3.2",
    "@types/jest": "^29.5.0",
    "@types/node": "^16.18.126",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/woodfishhhh/Woodfish-Theme.git"
  }
}
