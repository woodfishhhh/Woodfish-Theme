{
  "name": "woodfish-workspace",
  "private": true,
  "description": "Woodfish monorepo: shared theme core plus per-host apps (VS Code extension first).",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "compile": "npm run compile --workspaces --if-present",
    "build:dev": "npm run build:dev -w apps/vscode-extension",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present --",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "verify": "npm run verify --workspaces --if-present",
    "test:integration": "npm run test:integration -w apps/vscode-extension",
    "themes:generate": "npm run themes:generate -w apps/vscode-extension",
    "themes:check": "npm run themes:check -w apps/vscode-extension",
    "runtime:build": "npm run runtime:build -w apps/vscode-extension",
    "runtime:check": "npm run runtime:check -w apps/vscode-extension",
    "codex:build": "npm run codex:build -w apps/desktop-cli",
    "codex:check": "npm run codex:check -w apps/desktop-cli",
    "woodfish": "node apps/desktop-cli/out/woodfish.js",
    "package": "npm run package -w apps/vscode-extension --",
    "pre-publish": "npm run pre-publish -w apps/vscode-extension",
    "publish:vscode": "npm run publish -w apps/vscode-extension",
    "publish:vscode:pre-release": "npm run publish:pre-release -w apps/vscode-extension"
  },
  "devDependencies": {
    "@ljharb/tsconfig": "^0.3.2",
    "@types/jest": "^29.5.0",
    "@types/node": "^16.18.126",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/woodfishhhh/Woodfish-Theme.git"
  }
}
