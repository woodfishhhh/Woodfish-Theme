{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Woodfish VS Code extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"],
      "outFiles": [
        "${workspaceFolder}/apps/vscode-extension/out/**/*.js",
        "${workspaceFolder}/packages/theme-core/out/**/*.js"
      ],
      "preLaunchTask": "npm: build:dev"
    }
  ]
}
